# Architekt Wolności — skopiuj do src/.env (nie commituj).
# Vite/Tauri + backend Python (env_bootstrap.py).

# ── Środowisko ────────────────────────────────────────────────
AW_ENV=development

# ── LLM ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
XAI_API_KEY=
LLM_BACKEND=anthropic
AW_LLM_TIMEOUT_SDK=45
AW_LLM_TIMEOUT_WAIT=55
AW_DREAM_TIMEOUT_WAIT=60

# ── API / auth ────────────────────────────────────────────────
ARCHITEKT_JWT_SECRET=
ARCHITEKT_ADMIN_TOKEN=
# ARCHITEKT_API_KEY=          # legacy — nie używaj razem z JWT
# VITE_ARCHITEKT_API_KEY=

VITE_API_URL=http://127.0.0.1:8000
# VITE_PRIVACY_URL=https://example.com/privacy
# AW_INSECURE_NO_AUTH=1       # dev-only, NIGDY w produkcji

# ── CORS / sieć ───────────────────────────────────────────────
AW_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# ── Dane ──────────────────────────────────────────────────────
ARCHITEKT_DB_PATH=data/architekt.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/architekt
REDIS_URL=redis://localhost:6379

# ── AKSJOMAT 2 ────────────────────────────────────────────────
MAX_ACTIVE_PROJECTS=7
STALE_DAYS_AT_RISK=14
STALE_DAYS_STUCK=30
AW_AGENT_EVOLUTION=1

# ── Koszty / limity ───────────────────────────────────────────
# DAILY_BUDGET_USD=5
# DAILY_BUDGET_HARD_USD=10

# ── Observability (prod) ──────────────────────────────────────
# LOG_FORMAT=json
# SENTRY_DSN=
