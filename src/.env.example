# Architekt Wolności — przykładowe zmienne (skopiuj do `src/.env` obok tego pliku).
# Nie commituj `src/.env` — jest ignorowany przez git.
#
# Ten katalog (`src/`) trzyma jeden plik `.env` dla Vite/Tauri **i** dla backendu
# Python (ładowany przy starcie przez `env_bootstrap.py`). Inna ścieżka: ustaw `AW_ENV_FILE`.
#
# **ANTHROPIC_API_KEY** i inne sekrety zostaw puste tutaj — ustaw je tylko w `src/.env`.

ANTHROPIC_API_KEY=
ARCHITEKT_JWT_SECRET=
VITE_API_URL=http://127.0.0.1:8000
# xAI (OpenAI-compatible). Gdy brak Anthropic lub LLM_BACKEND=xai — Rada i destylacja marzenia.
XAI_API_KEY=
# auto | anthropic | xai — auto: Anthropic jeśli jest klucz, inaczej xAI
# LLM_BACKEND=auto
# XAI_API_BASE=https://api.x.ai/v1
# MODEL_XAI_OPUS=grok-3
# MODEL_XAI_SONNET=grok-3-mini
# MODEL_XAI_HAIKU=grok-3-mini
REDIS_URL=redis://localhost:6379
ARCHITEKT_DB_PATH=data/architekt.db

# CORS: lista po przecinku lub `*` (dev). Produkcja: np. https://twoja-domena.pl
AW_CORS_ORIGINS=*

# AKSJOMAT 2
MAX_ACTIVE_PROJECTS=7
STALE_DAYS_AT_RISK=14
STALE_DAYS_STUCK=30

# Jedna domena: API + zbudowane `ui/dist` (npm run build)
# AW_SERVE_UI=1
# AW_UI_DIST=ui/dist

# P5: ewolucja agentów (rolling notatki z debat → kolejne prompty). Wyłącz: 0
AW_AGENT_EVOLUTION=1

# Koszty / logi
# DAILY_BUDGET_USD=5
# COST_LOG_PATH=cost_log.jsonl

# === Production tuning (dodane przy budowie produkcyjnej) ===
# Token Bearer dla FA2 API (silny token gdy backend wyjdzie poza localhost)
# AW_API_TOKEN=
# Rate-limit FA2 (req/min per IP lub token); default 30
# AW_FA2_RATE=30
# Kompresja perspektyw przed Syez (znaki); niżej = taniej, mniej kontekstu
# AW_SYEZ_PERSPECTIVE_CHARS=400
# TTL cache FA2 w sekundach (default 604800 = 7 dni)
# AW_FA2_CACHE_TTL=604800
# TTL cache personal w sekundach (default 86400 = 24h)
# AW_CACHE_TTL=86400
# Bypass cache LLM (1 = zawsze świeże; default puste)
# DISABLE_CACHE=
