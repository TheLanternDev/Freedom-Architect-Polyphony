{
  "productName": "Freedom Architect",
  "version": "0.1.0",
  "identifier": "com.patryk.architekt-wolnosci",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Freedom Architect",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' tauri: ipc: https://fonts.googleapis.com https://fonts.gstatic.com http://127.0.0.1:8000 http://localhost:8000 ws://localhost:8000 ws://127.0.0.1:8000; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: tauri:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "windows": {
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
