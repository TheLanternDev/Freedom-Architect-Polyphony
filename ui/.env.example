# Architekt Wolności — przykładowe zmienne (skopiuj do `ui/.env` obok tego pliku).
# Nie commituj `ui/.env` ani `.env` w korzeniu repozytorium — oba są ignorowane przez git.
#
# Ten katalog (`ui/`) trzyma jeden plik `.env` dla Vite/Tauri **i** dla backendu
# Python (ładowany przy starcie przez `env_bootstrap.py`). Inna ścieżka: ustaw `AW_ENV_FILE`.
#
# Zsynchronizowane z lokalnego `.env` są wyłącznie **bezpieczne** wartości (ścieżki, URL-e Redis bez hasła w ścieżce publicznej, limity liczbowe, flagi AW_*).
# **ANTHROPIC_API_KEY** i inne sekrety zawsze zostaw puste tutaj — ustaw je tylko w `ui/.env` (nie commituj).

ANTHROPIC_API_KEY=
# xAI (OpenAI-compatible). Gdy brak Anthropic lub LLM_BACKEND=xai — Rada i destylacja marzenia.
XAI_API_KEY=
# auto | anthropic | xai — auto: Anthropic jeśli jest klucz, inaczej xAI
# LLM_BACKEND=auto
# XAI_API_BASE=https://api.x.ai/v1
# MODEL_XAI_OPUS=grok-3
# MODEL_XAI_SONNET=grok-3-mini
# MODEL_XAI_HAIKU=grok-3-mini
REDIS_URL=redis://localhost:6379
ARCHITEKT_DB_PATH=data/architekt.db

# CORS: lista po przecinku lub `*` (dev). Produkcja: np. https://twoja-domena.pl
AW_CORS_ORIGINS=*

# AKSJOMAT 2
MAX_ACTIVE_PROJECTS=7
STALE_DAYS_AT_RISK=14
STALE_DAYS_STUCK=30

# Jedna domena: API + zbudowane `ui/dist` (npm run build)
# AW_SERVE_UI=1
# AW_UI_DIST=ui/dist

# P5: ewolucja agentów (rolling notatki z debat → kolejne prompty). Wyłącz: 0
AW_AGENT_EVOLUTION=1

# Koszty / logi
# DAILY_BUDGET_USD=5
# COST_LOG_PATH=cost_log.jsonl
