# Kopiuj do `.env` (nie commituj). W CI używaj sekretów menedżera (Vault / sealed secrets).

# ── LLM ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
XAI_API_KEY=
LLM_BACKEND=anthropic

# ── API Architekta ────────────────────────────────────────────
# W przeglądarce NIE umieszczaj stałego klucza — BFF/proxy dodaje nagłówek serwisowy lub JWT.
ARCHITEKT_API_KEY=
ARCHITEKT_ADMIN_TOKEN=

# JWT użytkownika (HS256) — sekret tylko po stronie serwera emisji tokenów / API gateway
ARCHITEKT_JWT_SECRET=
# ARCHITEKT_JWT_ISSUER=https://auth.example.com
# ARCHITEKT_JWT_AUDIENCE=architekt-api

# Klucz serwisu (np. BFF → backend); stripuj ten nagłówek od niezaufanych klientów na proxy
# ARCHITEKT_SERVICE_HEADER=X-Architekt-Service-Key

# Tenant (opcjonalnie): claim JWT `tenant_id` + nagłówek X-Tenant-Id
# AW_REQUIRE_TENANT_JWT_CLAIM=1
# AW_ENFORCE_TENANT_HEADER=1

# ── Środowisko ────────────────────────────────────────────────
AW_ENV=development
# Produkcja: wyłącza OpenAPI/docs domyślnie (AW_FORCE_OPENAPI=1 w razie potrzeby)
AW_CORS_ORIGINS=http://localhost:5173

# ── Dane ──────────────────────────────────────────────────────
ARCHITEKT_DB_PATH=data/architekt.db
# Domyślnie: data/cost_log.jsonl (override zachowuje np. stary plik w korzeniu)
# COST_LOG_PATH=data/cost_log.jsonl
# DATABASE_URL=postgresql://user:pass@host:5432/architekt

REDIS_URL=redis://localhost:6379
